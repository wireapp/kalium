CREATE TABLE IF NOT EXISTS CellFile (
    uuid           TEXT    NOT NULL,
    conversationId TEXT,
    name           TEXT,
    owner          TEXT,
    localPath      TEXT,
    size           INTEGER,
    downloadedAt   INTEGER NOT NULL,
    modifiedAt     INTEGER,
    isOffline      INTEGER NOT NULL DEFAULT 0,
    assetVersionId TEXT NOT NULL DEFAULT '',
    cellAsset      INTEGER NOT NULL DEFAULT 1,
    contentUrl     TEXT,
    previewUrl     TEXT,
    assetMimeType  TEXT,
    assetPath      TEXT,
    contentHash    TEXT,
    assetWidth     INTEGER,
    assetHeight    INTEGER,
    assetDurationMs INTEGER,
    assetTransferStatus TEXT NOT NULL DEFAULT 'NOT_DOWNLOADED',
    contentUrlExpiresAt INTEGER,
    editSupported  INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (uuid)
);

upsertCellFile:
INSERT INTO CellFile(uuid, conversationId, name, owner, assetMimeType, localPath, size, downloadedAt, isOffline, modifiedAt, assetPath)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(uuid) DO UPDATE SET
    conversationId = COALESCE(excluded.conversationId, conversationId),
    name = COALESCE(excluded.name, name),
    owner = COALESCE(excluded.owner, owner),
    assetMimeType = COALESCE(excluded.assetMimeType, assetMimeType),
    localPath = COALESCE(excluded.localPath, localPath),
    size = COALESCE(excluded.size, size),
    downloadedAt = excluded.downloadedAt,
    isOffline = MAX(isOffline, excluded.isOffline),
    modifiedAt = COALESCE(excluded.modifiedAt, modifiedAt),
    assetPath = COALESCE(excluded.assetPath, assetPath);

deleteCellFile:
DELETE FROM CellFile WHERE uuid = ?;

-- Deleting a row a message refers to would remove the attachment from the message (MessageAttachments cascades):
-- such rows are kept, only their local copy is forgotten.
clearLocalCopyOfAttachment:
UPDATE CellFile SET isOffline = 0, localPath = NULL
WHERE uuid = ? AND uuid IN (SELECT asset_id FROM MessageAttachments);

deleteStandaloneCellFile:
DELETE FROM CellFile
WHERE uuid = ? AND uuid NOT IN (SELECT asset_id FROM MessageAttachments);

-- The files stored at any depth under a folder: those whose path is in [pathStart, pathEnd), i.e. starts with
-- pathStart ("folder/") as pathEnd is "folder0", '0' coming right after '/' in byte order. Unlike LIKE, no character in
-- names acts as a wildcard; comparing with the column also keeps the parameters typed as TEXT.
selectLocalPathsUnderPath:
SELECT uuid, localPath FROM CellFile
WHERE localPath IS NOT NULL AND assetPath >= :pathStart AND assetPath < :pathEnd;

markAttachmentsUnderPathNotFound:
UPDATE CellFile SET assetTransferStatus = :assetTransferStatus, isOffline = 0, localPath = NULL
WHERE assetPath >= :pathStart AND assetPath < :pathEnd AND uuid IN (SELECT asset_id FROM MessageAttachments);

deleteStandaloneCellFilesUnderPath:
DELETE FROM CellFile
WHERE assetPath >= :pathStart AND assetPath < :pathEnd AND uuid NOT IN (SELECT asset_id FROM MessageAttachments);

clearOfflineAccess:
UPDATE CellFile SET isOffline = 0, localPath = NULL WHERE uuid = ?;

observeOfflineFiles:
SELECT * FROM CellFile WHERE isOffline = 1;

observeOfflineFilesByConversationId:
SELECT * FROM CellFile WHERE isOffline = 1 AND conversationId = ?;

selectById:
SELECT * FROM CellFile WHERE uuid = ?;

getLocalPathsByIds:
SELECT uuid, localPath FROM CellFile WHERE localPath IS NOT NULL AND uuid IN ?;

setTransferStatus:
UPDATE CellFile
SET assetTransferStatus = ?
WHERE uuid = ?;

upsertAttachmentFile:
-- @NotifyCustomKey message_list_:conversationId
-- @NotifyCustomKey CellFile
INSERT INTO CellFile(
    uuid,
    conversationId,
    localPath,
    size,
    downloadedAt,
    modifiedAt,
    isOffline,
    assetVersionId,
    cellAsset,
    contentUrl,
    previewUrl,
    assetMimeType,
    assetPath,
    contentHash,
    assetWidth,
    assetHeight,
    assetDurationMs,
    assetTransferStatus,
    contentUrlExpiresAt,
    editSupported
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(uuid) DO UPDATE SET
    conversationId = COALESCE(excluded.conversationId, conversationId),
    localPath = COALESCE(excluded.localPath, localPath),
    size = COALESCE(excluded.size, size),
    downloadedAt = excluded.downloadedAt,
    modifiedAt = COALESCE(excluded.modifiedAt, modifiedAt),
    assetVersionId = excluded.assetVersionId,
    cellAsset = excluded.cellAsset,
    contentUrl = COALESCE(excluded.contentUrl, contentUrl),
    previewUrl = COALESCE(excluded.previewUrl, previewUrl),
    assetMimeType = COALESCE(excluded.assetMimeType, assetMimeType),
    assetPath = COALESCE(excluded.assetPath, assetPath),
    contentHash = COALESCE(excluded.contentHash, contentHash),
    assetWidth = COALESCE(excluded.assetWidth, assetWidth),
    assetHeight = COALESCE(excluded.assetHeight, assetHeight),
    assetDurationMs = COALESCE(excluded.assetDurationMs, assetDurationMs),
    assetTransferStatus = COALESCE(excluded.assetTransferStatus, assetTransferStatus),
    contentUrlExpiresAt = COALESCE(excluded.contentUrlExpiresAt, contentUrlExpiresAt),
    editSupported = excluded.editSupported;
