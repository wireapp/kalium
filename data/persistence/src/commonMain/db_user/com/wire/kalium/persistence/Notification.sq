getNotificationsMessages:
-- Seed from UnreadEvent (tiny, indexed by conversation_id+creation_date). The CTE is
-- deliberately kept to a single table with no joins or filters so SQLite *cannot* flatten
-- it into the outer query and reorder the joins. Without ANALYZE stats the planner tends
-- to pick Message (hundreds of thousands of rows) as the driving table; keeping the CTE
-- isolated + using CROSS JOIN on the outer keeps UnreadEvent as the outer loop.
WITH UnreadCandidates AS (
    SELECT
        ue.id AS messageId,
        ue.conversation_id AS messageConversationId,
        ue.creation_date AS unreadCreationDate,
        ROW_NUMBER() OVER (PARTITION BY ue.conversation_id ORDER BY ue.creation_date DESC) AS row_num
    FROM UnreadEvent ue
)
SELECT
    m.id AS id,
    m.conversation_id AS conversationId,
    m.content_type AS contentType,
    m.creation_date AS date,
    m.sender_user_id AS senderUserId,
    (m.expire_after_millis IS NOT NULL) AS isSelfDelete,
    u.name AS senderName,
    u.preview_asset_id AS senderPreviewAssetId,
    c.name AS conversationName,
    COALESCE(tc.text_body, pc.question) AS text,
    tc.is_quoting_self AS isQuotingSelf,
    ac.asset_mime_type AS assetMimeType,
    c.muted_status AS mutedStatus,
    c.type AS conversationType,
    c.degraded_conversation_notified AS degradedConversationNotified,
    c.legal_hold_status AS legalHoldStatus,
    IFNULL(lhs.legal_hold_status_change_notified, 1) == 1 AS legalHoldStatusChangeNotified
FROM UnreadCandidates uc
CROSS JOIN Message m ON m.id = uc.messageId AND m.conversation_id = uc.messageConversationId
CROSS JOIN Conversation c ON c.qualified_id = uc.messageConversationId
CROSS JOIN User u ON u.qualified_id = m.sender_user_id
LEFT JOIN ConversationLegalHoldStatusChangeNotified AS lhs
    ON lhs.conversation_id = uc.messageConversationId
LEFT JOIN MessageAssetContent ac
    ON ac.message_id = uc.messageId AND ac.conversation_id = uc.messageConversationId
LEFT JOIN MessageTextContent tc
    ON tc.message_id = uc.messageId AND tc.conversation_id = uc.messageConversationId
LEFT JOIN PollContent pc
    ON pc.message_id = uc.messageId AND pc.conversation_id = uc.messageConversationId
WHERE
    uc.row_num <= 10 -- there is a bug in sqldelight where you can't use a parameter here
    AND c.muted_status != 'ALL_MUTED'
    AND c.archived = 0
    AND uc.unreadCreationDate > COALESCE(c.last_notified_date, 0)
    AND m.visibility = 'VISIBLE'
    AND (
        m.content_type IN ('TEXT', 'RESTRICTED_ASSET', 'ASSET', 'KNOCK', 'MISSED_CALL', 'LOCATION', 'POLL')
        OR (
            m.content_type = 'MULTIPART'
            AND c.type IN ('GROUP', 'CHANNEL', 'MEETING')
            AND LENGTH(TRIM(tc.text_body)) > 0
            AND EXISTS (SELECT 1 FROM MessageMention
                WHERE message_id = m.id AND conversation_id = m.conversation_id AND user_id IS NULL)
        )
    )
    AND NOT EXISTS (SELECT 1 FROM SelfUser WHERE id = m.sender_user_id)
ORDER BY m.creation_date DESC;

CREATE TABLE MessageNotificationIdentity (
    notification_message_id TEXT NOT NULL,
    conversation_id TEXT NOT NULL,
    current_message_id TEXT NOT NULL,
    PRIMARY KEY (notification_message_id, conversation_id),
    FOREIGN KEY (current_message_id, conversation_id) REFERENCES Message(id, conversation_id)
        ON UPDATE CASCADE ON DELETE CASCADE
);

-- Keep FK checks bounded on every platform, including accounts with many historical alerts.
CREATE INDEX message_notification_identity_current ON MessageNotificationIdentity(current_message_id, conversation_id);

-- Only Apple hosts register notification identities. Existing aliases must survive
-- stale snapshots and follow subsequent message edits through the composite FK.
rememberNotificationMessage:
INSERT OR IGNORE INTO MessageNotificationIdentity(notification_message_id, conversation_id, current_message_id)
SELECT id, conversation_id, id FROM Message
WHERE id = :message_id AND conversation_id = :conversation_id;

resolveNotificationMessage:
SELECT n.current_message_id FROM MessageNotificationIdentity n
JOIN Message m ON m.id = n.current_message_id AND m.conversation_id = n.conversation_id
WHERE n.notification_message_id = :message_id AND m.conversation_id = :conversation_id;

-- Missing rows are not evidence of deletion: ephemeral expiry also removes rows.
getNotificationRemovalCandidates:
SELECT m.id, m.conversation_id
FROM Message m
JOIN Conversation c ON c.qualified_id = m.conversation_id
WHERE m.id IN :message_ids
AND ((m.visibility = 'DELETED' AND m.expire_after_millis IS NULL)
     OR m.creation_date <= c.last_read_date)
UNION
SELECT n.notification_message_id AS id, m.conversation_id
FROM MessageNotificationIdentity n
JOIN Message m ON m.id = n.current_message_id AND m.conversation_id = n.conversation_id
JOIN Conversation c ON c.qualified_id = m.conversation_id
WHERE n.notification_message_id IN :message_ids
AND ((m.visibility = 'DELETED' AND m.expire_after_millis IS NULL)
     OR m.creation_date <= c.last_read_date);
