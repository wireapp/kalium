import com.wire.kalium.persistence.dao.QualifiedIDEntity;
import com.wire.kalium.persistence.dao.unread.UnreadEventTypeEntity;
import kotlin.time.Instant;

CREATE TABLE UnreadEvent (
      id TEXT NOT NULL,
      type TEXT AS UnreadEventTypeEntity NOT NULL,
      conversation_id TEXT AS QualifiedIDEntity NOT NULL,
      creation_date INTEGER AS Instant NOT NULL,

    FOREIGN KEY (id, conversation_id) REFERENCES Message(id, conversation_id) ON DELETE CASCADE ON UPDATE CASCADE,
    PRIMARY KEY (id, conversation_id)
);
CREATE INDEX unread_event_conv_tyoe ON UnreadEvent(conversation_id, type);
CREATE INDEX unread_event_conv_date ON UnreadEvent(conversation_id, creation_date);

deleteUnreadEvent:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
DELETE FROM UnreadEvent WHERE id = ? AND conversation_id = ?;

deleteUnreadEvents:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
DELETE FROM UnreadEvent
WHERE creation_date <= ? AND conversation_id = ?
    AND NOT EXISTS (
        SELECT 1 FROM Conversation
        WHERE qualified_id = UnreadEvent.conversation_id AND manual_unread_date IS NOT NULL
    );

deleteConversationUnreadEvents:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
DELETE FROM UnreadEvent WHERE conversation_id = ?;

restoreManualUnreadEvents:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
INSERT OR IGNORE INTO UnreadEvent(id, type, conversation_id, creation_date)
SELECT M.id,
    CASE
        WHEN M.content_type = 'KNOCK' THEN 'KNOCK'
        WHEN M.content_type = 'MISSED_CALL' THEN 'MISSED_CALL'
        WHEN M.content_type = 'TEXT' AND T.is_quoting_self = 1 THEN 'REPLY'
        WHEN M.content_type = 'TEXT' AND EXISTS (
            SELECT 1 FROM MessageMention
            WHERE message_id = M.id AND conversation_id = M.conversation_id
                AND (user_id = S.id OR (user_id IS NULL AND C.type IN ('GROUP', 'CHANNEL', 'MEETING')))
        ) THEN 'MENTION'
        ELSE 'MESSAGE'
    END,
    M.conversation_id, M.creation_date
FROM Message M
JOIN SelfUser S
JOIN Conversation C ON C.qualified_id = M.conversation_id
LEFT JOIN MessageTextContent T ON T.message_id = M.id AND T.conversation_id = M.conversation_id
WHERE M.conversation_id = :conversationId AND M.creation_date >= :unreadFrom
    AND M.sender_user_id != S.id AND M.visibility = 'VISIBLE' AND M.status != 'PENDING'
    AND M.content_type IN ('TEXT', 'ASSET', 'RESTRICTED_ASSET', 'KNOCK', 'MISSED_CALL',
        'COMPOSITE', 'POLL', 'LOCATION', 'MULTIPART', 'FAILED_DECRYPTION');

insertEvent:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
INSERT OR IGNORE INTO UnreadEvent(id, type, conversation_id, creation_date)
VALUES(?, ?, ?, ?);

updateEvent:
-- @NotifyCustomKey conversation_list_unread
-- @NotifyCustomKey UnreadEvent
UPDATE OR IGNORE UnreadEvent
SET type = :type
WHERE id = :id AND conversation_id = :conversation_id;

getUnreadEvents:
SELECT conversation_id, type FROM UnreadEvent;

getConversationUnreadEventsCount:
SELECT COUNT(*) FROM UnreadEvent WHERE conversation_id = ?;

getHasUnreadEventsForConversationAtOrBeforeDate:
SELECT EXISTS(
    SELECT 1 FROM UnreadEvent WHERE conversation_id = :conversationId AND creation_date <= :creationDate
);

getUnreadArchivedConversationsCount:
SELECT COUNT(*) FROM Conversation C
WHERE C.archived = 1 AND (C.manual_unread_date IS NOT NULL
    OR EXISTS (SELECT 1 FROM UnreadEvent WHERE conversation_id = C.qualified_id));

-- Count conversations, including archived ones, without loading message previews or list pages.
getUnreadConversationBadgeCount:
SELECT COUNT(*) FROM Conversation c
WHERE c.deleted_locally = 0
    AND c.type IN ('GROUP', 'CHANNEL', 'ONE_ON_ONE')
    -- Uncorrelated so User is scanned once; active_one_on_one_conversation_id has no index.
    -- The conversation list hides one-to-ones until the peer's name is known.
    AND (c.type != 'ONE_ON_ONE' OR c.qualified_id IN (
        SELECT u.active_one_on_one_conversation_id FROM User u
        WHERE u.connection_status IS NOT 'BLOCKED' AND u.deleted IS NOT 1 AND u.name IS NOT NULL
    ))
    AND (c.manual_unread_date IS NOT NULL OR EXISTS (
        SELECT 1 FROM UnreadEvent ue WHERE ue.conversation_id = c.qualified_id
            AND (c.muted_status IN ('ALL_ALLOWED', 'MENTIONS_MUTED')
                OR (c.muted_status = 'ONLY_MENTIONS_AND_REPLIES_ALLOWED'
                    AND ue.type IN ('MENTION', 'REPLY', 'MISSED_CALL')))
    ));

CREATE VIEW IF NOT EXISTS UnreadEventCountsGrouped AS
SELECT
    conversation_id AS conversationId,
    SUM(CASE WHEN type = 'KNOCK' THEN 1 ELSE 0 END) AS knocksCount,
    SUM(CASE WHEN type = 'MISSED_CALL' THEN 1 ELSE 0 END) AS missedCallsCount,
    SUM(CASE WHEN type = 'MENTION' THEN 1 ELSE 0 END) AS mentionsCount,
    SUM(CASE WHEN type = 'REPLY' THEN 1 ELSE 0 END) AS repliesCount,
    SUM(CASE WHEN type = 'MESSAGE' THEN 1 ELSE 0 END) AS messagesCount
FROM UnreadEvent
GROUP BY conversation_id;

getConversationsUnreadEventCountsGrouped:
SELECT * FROM UnreadEventCountsGrouped;

getHasUnreadEventsForConversation:
SELECT EXISTS(
    SELECT 1 FROM Conversation C WHERE C.qualified_id = :conversationId
        AND (C.manual_unread_date IS NOT NULL
            OR EXISTS (SELECT 1 FROM UnreadEvent WHERE conversation_id = C.qualified_id))
);
