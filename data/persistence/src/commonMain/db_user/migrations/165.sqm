-- Accepting used to leave the stored request in its earlier state, so accepted requests still showed as pending.
-- Team and collaborator sync also mark users accepted, so a request is only fixed once its conversation stopped being pending.
UPDATE Connection
SET status = 'ACCEPTED'
WHERE status IN ('PENDING', 'SENT', 'IGNORED')
    AND qualified_to IN (SELECT qualified_id FROM User WHERE connection_status = 'ACCEPTED')
    AND qualified_conversation NOT IN (SELECT qualified_id FROM Conversation WHERE type = 'CONNECTION_PENDING');
