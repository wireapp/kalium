user_id = CASE WHEN user_id LIKE '%@' THEN (user_id || (SELECT self_domain FROM self_domain_cte)) ELSE user_id END;

WITH self_domain_cte AS (
SELECT substr(id, instr(id, '@') + 1) AS self_domain FROM SelfUser
)
UPDATE OR IGNORE Reaction
SET
conversation_id = CASE WHEN conversation_id LIKE '%@' THEN (conversation_id || (SELECT self_domain FROM self_domain_cte)) ELSE conversation_id END,
sender_id = CASE WHEN sender_id LIKE '%@' THEN (sender_id || (SELECT self_domain FROM self_domain_cte)) ELSE sender_id END;

